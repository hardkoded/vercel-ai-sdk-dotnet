{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Vercel.AI/Vercel.AI.csproj",
            "Vercel.AI.Provider/Vercel.AI.Provider.csproj",
            "Vercel.AI.Gateway/Vercel.AI.Gateway.csproj",
            "Vercel.AI.AspNetCore/Vercel.AI.AspNetCore.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["articles/**.md", "articles/toc.yml", "toc.yml", "index.md"] }
    ],
    "resource": [{ "files": ["images/**"] }],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Vercel AI SDK for .NET",
      "_appName": "Vercel.AI",
      "_appFooter": "Apache-2.0 · Copyright 2023 Vercel, Inc. · unofficial community port, not an official Vercel product",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/hardkoded/vercel-ai-sdk-dotnet",
        "branch": "main"
      }
    },
    "markdownEngineName": "markdig",
    "sitemap": {
      "baseUrl": "https://hardkoded.github.io/vercel-ai-sdk-dotnet",
      "priority": 0.5,
      "changefreq": "weekly"
    }
  }
}
