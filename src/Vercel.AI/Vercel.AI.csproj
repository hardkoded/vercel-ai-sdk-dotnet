<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Community .NET port of the Vercel AI SDK. Generate text, stream, call tools, and embed through any provider. Not an official Vercel product.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>ai;vercel;llm;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Vercel.AI.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="AngleSharp" Version="1.8.5" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="AspNetCore/**" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!--
    Installs the Husky.Net git hooks (.husky/) for contributors on restore/build.
    Skipped in CI (CI=true or HUSKY=0) and when the checkout has no .git directory.
  -->
  <Target Name="Husky" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != '0' AND '$(CI)' != 'true' AND Exists('$(MSBuildThisFileDirectory)../../.git')">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory)../../" StandardOutputImportance="Low" StandardErrorImportance="High" ContinueOnError="true" />
    <Exec Command="dotnet husky install" WorkingDirectory="$(MSBuildThisFileDirectory)../../" StandardOutputImportance="Low" StandardErrorImportance="High" ContinueOnError="true" />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Vercel.AI.Tests" />
  </ItemGroup>
</Project>
